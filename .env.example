NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

POSTGRES_PASSWORD=replace_with_a_local_development_password
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5444/geofield?schema=public

JWT_ISSUER=geofield-pro-api
JWT_AUDIENCE=geofield-pro-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_PUBLIC_REGISTRATION=false
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace_with_a_local_seed_password

AUTH_COOKIE_NAME=geofield_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_REQUESTS=10
AUTH_REFRESH_WINDOW_MS=900000
AUTH_REFRESH_MAX_REQUESTS=20

# S3-compatible object storage (required for survey photo uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geofield-surveys
S3_ACCESS_KEY_ID=replace_with_storage_access_key
S3_SECRET_ACCESS_KEY=replace_with_storage_secret_key
S3_FORCE_PATH_STYLE=true

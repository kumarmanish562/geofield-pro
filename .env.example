# Local development only. Do not use these values in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Must match POSTGRES_PASSWORD in docker-compose.yml.
POSTGRES_PASSWORD=geofield_local_dev_only
DATABASE_URL=postgresql://geofield_admin:geofield_local_dev_only@localhost:5444/geofield?schema=public

JWT_ISSUER=geofield-pro-api
JWT_AUDIENCE=geofield-pro-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_SECRET=geofield-local-development-secret-change-before-deploy

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_PUBLIC_REGISTRATION=false
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=LocalAdminPassword123

AUTH_COOKIE_NAME=geofield_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_REQUESTS=10
AUTH_REFRESH_WINDOW_MS=900000
AUTH_REFRESH_MAX_REQUESTS=20

# Survey photos are stored under apps/api/uploads during local development.
LOCAL_UPLOAD_DIR=uploads

# In-app notifications work locally without a push provider.
NOTIFICATION_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_DELAY_MS=30000
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_DEADLINE_REMINDER_DAYS=1,3

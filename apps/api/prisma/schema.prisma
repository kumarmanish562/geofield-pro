
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  GIS_ANALYST
  EMPLOYEE

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  LOCKED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum TeamStatus {
  ACTIVE
  ARCHIVED

  @@map("team_status")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String             @db.VarChar(200)
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  sessions    AuthSession[]
  invitations OrganizationInvitation[]
  teams       Team[]
  employeeProfiles EmployeeProfile[]
  assignments      Assignment[]
  assignmentAudits AssignmentAuditLog[]

  @@index([status])
  @@map("organizations")
}

model User {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name                String     @db.VarChar(150)
  email               String     @unique @db.VarChar(320)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  role                UserRole   @default(EMPLOYEE)
  status              UserStatus @default(PENDING)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  passwordChangedAt   DateTime?  @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sessions        AuthSession[]
  sentInvitations OrganizationInvitation[] @relation("InvitationSender")
  auditEvents     AuditLog[]              @relation("AuditActor")
  passwordResets  PasswordResetToken[]
  employeeProfile EmployeeProfile?
  supervisedEmployees EmployeeProfile[] @relation("EmployeeSupervisor")
  supervisedTeams Team[] @relation("TeamSupervisor")
  teamMemberships TeamMembership[]
  managedAssignments Assignment[] @relation("AssignmentSupervisor")
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  updatedAssignments Assignment[] @relation("AssignmentUpdatedBy")
  assignmentMemberships AssignmentEmployee[] @relation("AssignmentEmployeeUser")
  assignedAssignmentEmployees AssignmentEmployee[] @relation("AssignmentAssignedBy")
  assignmentAudits AssignmentAuditLog[] @relation("AssignmentAuditActor")

  @@index([organizationId, status])
  @@index([organizationId, role])
  @@map("users")
}

model EmployeeProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeCode   String?  @map("employee_code") @db.VarChar(50)
  jobTitle       String?  @map("job_title") @db.VarChar(120)
  phone          String?  @db.VarChar(30)
  supervisorId   String?  @map("supervisor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisor   User?        @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@index([organizationId, supervisorId])
  @@map("employee_profiles")
}

model Team {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String     @db.VarChar(120)
  description    String?    @db.VarChar(500)
  supervisorId   String?    @map("supervisor_id") @db.Uuid
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisor   User?            @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  memberships  TeamMembership[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, supervisorId])
  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model Assignment {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  name                String           @db.VarChar(160)
  description         String?          @db.VarChar(2000)
  supervisorId        String           @map("supervisor_id") @db.Uuid
  workArea            String?          @map("work_area") @db.VarChar(200)
  startDate           DateTime         @map("start_date") @db.Date
  dueDate             DateTime         @map("due_date") @db.Date
  surveyRequirements  Json             @default("{}") @map("survey_requirements")
  targets             Json             @default("{}")
  status              AssignmentStatus @default(DRAFT)
  publishedAt         DateTime?        @map("published_at")
  createdById         String           @map("created_by_id") @db.Uuid
  updatedById         String           @map("updated_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisor User @relation("AssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  createdBy User @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  employees AssignmentEmployee[]
  auditLogs AssignmentAuditLog[]

  @@index([organizationId, status, dueDate])
  @@index([organizationId, supervisorId])
  @@map("assignments")
}

model AssignmentEmployee {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employee User @relation("AssignmentEmployeeUser", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([assignmentId, employeeId])
  @@index([employeeId, assignmentId])
  @@map("assignment_employees")
}

model AssignmentAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(60)
  previousValues Json?  @map("previous_values")
  newValues    Json?    @map("new_values")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User? @relation("AssignmentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assignmentId, createdAt])
  @@index([organizationId, createdAt])
  @@map("assignment_audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  event          String   @db.VarChar(100)
  targetType     String?  @map("target_type") @db.VarChar(100)
  targetId       String?  @map("target_id") @db.VarChar(100)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([organizationId, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  replacedByTokenId String? @unique @map("replaced_by_token_id") @db.Uuid

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt])
  @@index([sessionId, usedAt])
  @@map("refresh_tokens")
}

model OrganizationInvitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  invitedById    String? @map("invited_by_id") @db.Uuid

  email String   @db.VarChar(320)
  role  UserRole

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

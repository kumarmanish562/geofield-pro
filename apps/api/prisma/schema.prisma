
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  GIS_ANALYST
  EMPLOYEE

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  LOCKED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum TeamStatus {
  ACTIVE
  ARCHIVED

  @@map("team_status")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

enum AttendanceStatus {
  WORKING
  ON_BREAK
  COMPLETED

  @@map("attendance_status")
}

enum AttendanceEventType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
  CORRECTION_APPLIED

  @@map("attendance_event_type")
}

enum AttendanceEventStatus {
  PENDING
  PROCESSED
  REJECTED

  @@map("attendance_event_status")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("attendance_correction_status")
}

enum VillageStatus {
  ACTIVE
  INACTIVE

  @@map("village_status")
}

enum VillageImportStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("village_import_status")
}

enum TrackingSessionStatus {
  ACTIVE
  ENDED

  @@map("tracking_session_status")
}

enum SurveyStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED

  @@map("survey_status")
}

enum SurveyUploadStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("survey_upload_status")
}

enum SurveyReviewStatus {
  APPROVED
  REJECTED
  CORRECTION_REQUIRED

  @@map("survey_review_status")
}

enum SyncEventStatus {
  PROCESSED
  CONFLICT
  FAILED

  @@map("sync_event_status")
}

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String             @db.VarChar(200)
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  sessions    AuthSession[]
  invitations OrganizationInvitation[]
  teams       Team[]
  employeeProfiles EmployeeProfile[]
  assignments      Assignment[]
  assignmentAudits AssignmentAuditLog[]
  attendances      Attendance[]
  correctionRequests AttendanceCorrectionRequest[]
  attendanceAudits AttendanceAuditLog[]
  trackingSessions TrackingSession[]
  locationObservations LocationObservation[]
  villages       Village[]
  villageImports VillageImport[]
  surveys        Survey[]

  @@index([status])
  @@map("organizations")
}

model User {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name                String     @db.VarChar(150)
  email               String     @unique @db.VarChar(320)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  role                UserRole   @default(EMPLOYEE)
  status              UserStatus @default(PENDING)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  passwordChangedAt   DateTime?  @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sessions        AuthSession[]
  sentInvitations OrganizationInvitation[] @relation("InvitationSender")
  auditEvents     AuditLog[]              @relation("AuditActor")
  passwordResets  PasswordResetToken[]
  employeeProfile EmployeeProfile?
  supervisedEmployees EmployeeProfile[] @relation("EmployeeSupervisor")
  supervisedTeams Team[] @relation("TeamSupervisor")
  teamMemberships TeamMembership[]
  managedAssignments Assignment[] @relation("AssignmentSupervisor")
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  updatedAssignments Assignment[] @relation("AssignmentUpdatedBy")
  assignmentMemberships AssignmentEmployee[] @relation("AssignmentEmployeeUser")
  assignedAssignmentEmployees AssignmentEmployee[] @relation("AssignmentAssignedBy")
  assignmentAudits AssignmentAuditLog[] @relation("AssignmentAuditActor")
  attendances Attendance[]
  attendanceEvents AttendanceEvent[] @relation("AttendanceEventEmployee")
  correctionRequests AttendanceCorrectionRequest[] @relation("AttendanceCorrectionEmployee")
  attendanceReviews AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewer")
  attendanceAudits AttendanceAuditLog[] @relation("AttendanceAuditActor")
  trackingSessions TrackingSession[] @relation("TrackingSessionEmployee")
  startedTrackingSessions TrackingSession[] @relation("TrackingSessionStartedBy")
  locationObservations LocationObservation[]
  createdVillages Village[] @relation("VillageCreatedBy")
  updatedVillages Village[] @relation("VillageUpdatedBy")
  villageImports VillageImport[]
  surveys        Survey[]
  uploadedSurveyAttachments SurveyAttachment[] @relation("SurveyAttachmentUploader")
  surveyReviews  SurveyReview[] @relation("SurveyReviewer")
  syncEvents     SyncEvent[]
  syncHistory    SyncHistory[]

  @@index([organizationId, status])
  @@index([organizationId, role])
  @@map("users")
}

model EmployeeProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeCode   String?  @map("employee_code") @db.VarChar(50)
  jobTitle       String?  @map("job_title") @db.VarChar(120)
  phone          String?  @db.VarChar(30)
  supervisorId   String?  @map("supervisor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisor   User?        @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@index([organizationId, supervisorId])
  @@map("employee_profiles")
}

model Team {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String     @db.VarChar(120)
  description    String?    @db.VarChar(500)
  supervisorId   String?    @map("supervisor_id") @db.Uuid
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisor   User?            @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  memberships  TeamMembership[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, supervisorId])
  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model Assignment {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  name                String           @db.VarChar(160)
  description         String?          @db.VarChar(2000)
  supervisorId        String           @map("supervisor_id") @db.Uuid
  workArea            String?          @map("work_area") @db.VarChar(200)
  startDate           DateTime         @map("start_date") @db.Date
  dueDate             DateTime         @map("due_date") @db.Date
  surveyRequirements  Json             @default("{}") @map("survey_requirements")
  targets             Json             @default("{}")
  status              AssignmentStatus @default(DRAFT)
  publishedAt         DateTime?        @map("published_at")
  createdById         String           @map("created_by_id") @db.Uuid
  updatedById         String           @map("updated_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisor User @relation("AssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  createdBy User @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  employees AssignmentEmployee[]
  auditLogs AssignmentAuditLog[]
  surveys Survey[]

  @@index([organizationId, status, dueDate])
  @@index([organizationId, supervisorId])
  @@map("assignments")
}

model AssignmentEmployee {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employee User @relation("AssignmentEmployeeUser", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([assignmentId, employeeId])
  @@index([employeeId, assignmentId])
  @@map("assignment_employees")
}

model AssignmentAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(60)
  previousValues Json?  @map("previous_values")
  newValues    Json?    @map("new_values")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User? @relation("AssignmentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assignmentId, createdAt])
  @@index([organizationId, createdAt])
  @@map("assignment_audit_logs")
}

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  attendanceDate   DateTime         @map("attendance_date") @db.Date
  status           AttendanceStatus
  checkedInAt     DateTime?        @map("checked_in_at")
  checkedOutAt    DateTime?        @map("checked_out_at")
  totalBreakSeconds Int             @default(0) @map("total_break_seconds")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  events AttendanceEvent[]
  breaks AttendanceBreak[]
  corrections AttendanceCorrectionRequest[]
  audits AttendanceAuditLog[]

  @@unique([employeeId, attendanceDate])
  @@index([organizationId, attendanceDate, status])
  @@index([employeeId, attendanceDate])
  @@map("attendances")
}

model AttendanceBreak {
  id           String   @id @default(uuid()) @db.Uuid
  attendanceId String   @map("attendance_id") @db.Uuid
  startedAt   DateTime @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSeconds Int? @map("duration_seconds")
  createdAt    DateTime @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, startedAt])
  @@map("attendance_breaks")
}

model AttendanceEvent {
  id               String                @id @default(uuid()) @db.Uuid
  attendanceId     String                @map("attendance_id") @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  eventType        AttendanceEventType   @map("event_type")
  serverOccurredAt DateTime              @map("server_occurred_at")
  clientOccurredAt DateTime?             @map("client_occurred_at")
  receivedAt       DateTime              @default(now()) @map("received_at")
  processingStatus AttendanceEventStatus  @default(PROCESSED) @map("processing_status")
  idempotencyKey   String?               @unique @map("idempotency_key") @db.VarChar(160)
  clientEventId    String?               @unique @map("client_event_id") @db.VarChar(160)
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee User @relation("AttendanceEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([attendanceId, createdAt])
  @@map("attendance_events")
}

model AttendanceCorrectionRequest {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  attendanceId        String           @map("attendance_id") @db.Uuid
  employeeId          String           @map("employee_id") @db.Uuid
  requestedCheckInAt  DateTime?        @map("requested_check_in_at")
  requestedCheckOutAt DateTime?        @map("requested_check_out_at")
  reason              String           @db.VarChar(1000)
  status              CorrectionStatus @default(PENDING)
  reviewedById        String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?        @map("reviewed_at")
  reviewComment       String?          @map("review_comment") @db.VarChar(1000)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee User @relation("AttendanceCorrectionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([employeeId, createdAt])
  @@map("attendance_correction_requests")
}

model AttendanceAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  attendanceId   String   @map("attendance_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(80)
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  reason         String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actor User? @relation("AttendanceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([attendanceId, createdAt])
  @@map("attendance_audit_logs")
}

model TrackingSession {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  employeeId     String                @map("employee_id") @db.Uuid
  startedById    String                @map("started_by_id") @db.Uuid
  status         TrackingSessionStatus @default(ACTIVE)
  startedAt      DateTime              @default(now()) @map("started_at")
  endedAt        DateTime?             @map("ended_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee User @relation("TrackingSessionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  startedBy User @relation("TrackingSessionStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  observations LocationObservation[]

  @@index([organizationId, status, employeeId])
  @@index([employeeId, startedAt])
  @@map("tracking_sessions")
}

model LocationObservation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  eventId        String   @map("event_id") @db.VarChar(160)
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(8, 2)
  capturedAt     DateTime @map("captured_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([employeeId, eventId])
  @@index([organizationId, receivedAt])
  @@index([employeeId, capturedAt])
  @@index([sessionId, capturedAt])
  @@map("location_observations")
}

model Village {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(200)
  code           String        @db.VarChar(80)
  state          String?       @db.VarChar(120)
  district       String?       @db.VarChar(120)
  taluka         String?       @db.VarChar(120)
  metadata       Json          @default("{}")
  status         VillageStatus @default(ACTIVE)
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String        @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("VillageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User         @relation("VillageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  surveys      Survey[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, district, taluka])
  @@map("villages")
}

model VillageImport {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  initiatedById      String             @map("initiated_by_id") @db.Uuid
  filename            String             @db.VarChar(255)
  format              String             @db.VarChar(30)
  status              VillageImportStatus @default(PROCESSING)
  totalFeatures       Int                @default(0) @map("total_features")
  acceptedFeatures    Int                @default(0) @map("accepted_features")
  rejectedFeatures    Int                @default(0) @map("rejected_features")
  errorSummary       Json               @default("[]") @map("error_summary")
  startedAt           DateTime           @default(now()) @map("started_at")
  completedAt         DateTime?          @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  initiatedBy  User         @relation(fields: [initiatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, startedAt])
  @@index([organizationId, status])
  @@map("village_imports")
}

model Survey {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  surveyNumber    String       @unique @map("survey_number") @db.VarChar(40)
  employeeId      String       @map("employee_id") @db.Uuid
  assignmentId    String       @map("assignment_id") @db.Uuid
  villageId       String       @map("village_id") @db.Uuid
  gatNumber       String       @map("gat_number") @db.VarChar(80)
  plotNumber      String?      @map("plot_number") @db.VarChar(80)
  latitude        Decimal?     @db.Decimal(9, 6)
  longitude       Decimal?     @db.Decimal(9, 6)
  gpsAccuracy     Decimal?     @map("gps_accuracy") @db.Decimal(8, 2)
  capturedAt      DateTime     @map("captured_at")
  notes           String?      @db.VarChar(4000)
  status          SurveyStatus @default(DRAFT)
  submittedAt     DateTime?    @map("submitted_at")
  submissionKey   String?      @unique @map("submission_key") @db.VarChar(160)
  clientSurveyId  String?      @unique @map("client_survey_id") @db.Uuid
  serverVersion   Int          @default(1) @map("server_version")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     User         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  village      Village      @relation(fields: [villageId], references: [id], onDelete: Restrict)
  attachments  SurveyAttachment[]
  reviews      SurveyReview[]

  @@index([organizationId, status, createdAt])
  @@index([employeeId, status, createdAt])
  @@index([assignmentId, villageId])
  @@map("surveys")
}

model SurveyAttachment {
  id               String             @id @default(uuid()) @db.Uuid
  clientAttachmentId String?         @unique @map("client_attachment_id") @db.Uuid
  surveyId         String             @map("survey_id") @db.Uuid
  uploadedBy       String             @map("uploaded_by") @db.Uuid
  originalFileName String             @map("original_file_name") @db.VarChar(255)
  objectKey        String             @unique @map("object_key") @db.VarChar(512)
  bucket           String             @db.VarChar(120)
  mimeType         String             @map("mime_type") @db.VarChar(100)
  fileSize         Int                @map("file_size")
  checksum         String?            @db.VarChar(128)
  uploadStatus     SurveyUploadStatus @default(PENDING) @map("upload_status")
  createdAt        DateTime           @default(now()) @map("created_at")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  uploader User @relation("SurveyAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([surveyId, uploadStatus])
  @@map("survey_attachments")
}

model SyncEvent {
  id            String          @id @default(uuid()) @db.Uuid
  clientEventId String          @unique @map("client_event_id") @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  entityType    String          @map("entity_type") @db.VarChar(40)
  entityId      String          @map("entity_id") @db.VarChar(80)
  operation     String          @db.VarChar(40)
  payloadHash   String          @map("payload_hash") @db.VarChar(128)
  payload       Json
  status        SyncEventStatus
  serverTimestamp DateTime      @default(now()) @map("server_timestamp")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([employeeId, status])
  @@map("sync_events")
}

model SyncHistory {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(40)
  entityId       String   @map("entity_id") @db.VarChar(80)
  operation      String   @db.VarChar(40)
  attemptNumber  Int      @map("attempt_number")
  startedAt      DateTime @map("started_at")
  completedAt    DateTime? @map("completed_at")
  result         String?  @db.VarChar(40)
  errorMessage   String?  @map("error_message") @db.VarChar(1000)
  serverResponse Json?    @map("server_response")
  createdAt      DateTime @default(now()) @map("created_at")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([employeeId, result])
  @@map("sync_history")
}

model SurveyReview {
  id           String             @id @default(uuid()) @db.Uuid
  surveyId     String             @map("survey_id") @db.Uuid
  reviewedBy   String             @map("reviewed_by") @db.Uuid
  reviewStatus SurveyReviewStatus @map("review_status")
  action       String             @default("REVIEW") @db.VarChar(40)
  previousStatus SurveyStatus?    @map("previous_status")
  newStatus    SurveyStatus?      @map("new_status")
  reviewNotes  String?            @map("review_notes") @db.VarChar(2000)
  reviewedAt   DateTime           @default(now()) @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  reviewer User   @relation("SurveyReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([surveyId, reviewedAt])
  @@index([reviewStatus, reviewedAt])
  @@map("survey_reviews")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  event          String   @db.VarChar(100)
  targetType     String?  @map("target_type") @db.VarChar(100)
  targetId       String?  @map("target_id") @db.VarChar(100)
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([organizationId, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  replacedByTokenId String? @unique @map("replaced_by_token_id") @db.Uuid

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt])
  @@index([sessionId, usedAt])
  @@map("refresh_tokens")
}

model OrganizationInvitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  invitedById    String? @map("invited_by_id") @db.Uuid

  email String   @db.VarChar(320)
  role  UserRole

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

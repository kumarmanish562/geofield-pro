{
  "name": "geofield-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "postcss": "8.5.26",
      "metro": "0.83.8"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @geofield/api dev",
    "dev:web": "pnpm --filter @geofield/admin-web dev",
    "dev:mobile": "pnpm --filter @geofield/employee-mobile start",
    "start": "pnpm --filter @geofield/api start",
    "build": "pnpm --filter @geofield/api build",
    "build:web": "pnpm --filter @geofield/admin-web build",
    "build:all": "pnpm build && pnpm build:web && pnpm build:mobile",
    "build:mobile": "pnpm --filter @geofield/employee-mobile build",
    "lint": "eslint .",
    "typecheck": "pnpm lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:api && pnpm test:web && pnpm test:mobile",
    "test:api": "pnpm --filter @geofield/api test",
    "test:web": "pnpm --filter @geofield/admin-web test",
    "test:mobile": "pnpm --filter @geofield/employee-mobile test",
    "test:watch": "pnpm --filter @geofield/api test:watch",
    "test:coverage": "pnpm --filter @geofield/api test:coverage",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:infra-status": "docker compose ps",
    "db:generate": "pnpm --filter @geofield/api db:generate",
    "db:migrate": "pnpm --filter @geofield/api db:migrate",
    "db:deploy": "pnpm --filter @geofield/api db:deploy",
    "db:status": "pnpm --filter @geofield/api db:status",
    "db:seed": "pnpm --filter @geofield/api db:seed",
    "db:studio": "pnpm --filter @geofield/api db:studio"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
